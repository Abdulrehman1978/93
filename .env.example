# ==============================================================================
# SAMBAL Intelligence & Response Layer — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the development environment.
# Note: Ports are mapped to 5493, 8093, 3093, 9093 to prevent local host collisions.

# Environment & Observability
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="SAMBAL Intelligence & Response Layer"
API_V1_PREFIX=/api/v1

# Security & Correlation
SECRET_KEY=change_this_to_a_secure_random_string_in_production_min_32_chars
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3093"]
SESSION_SECRET=sambal_session_signing_secret_dev_only

# Canonical PostgreSQL Database Configuration
# Port 5493 mapped in docker-compose.yml to avoid port 5432 collisions
POSTGRES_USER=sambal_user
POSTGRES_PASSWORD=sambal_secure_pass
POSTGRES_DB=sambal_db
POSTGRES_PORT=5493
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+asyncpg://sambal_user:sambal_secure_pass@localhost:5493/sambal_db
TEST_DATABASE_URL=postgresql+asyncpg://sambal_user:sambal_secure_pass@localhost:5493/sambal_test_db

# S3-Compatible Object Storage (MinIO)
# Port 9093 (API) / 9193 (Console) mapped in docker-compose.yml
S3_ENDPOINT_URL=http://localhost:9093
S3_ACCESS_KEY=sambal_minio_admin
S3_SECRET_KEY=sambal_minio_secret_key_2026
S3_BUCKET_NAME=sambal-ephemeral-audio
S3_REGION=us-east-1

# Application Server Ports
BACKEND_PORT=8093
WEB_PORT=3093

# Frontend Public Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8093
NEXT_PUBLIC_WS_URL=ws://localhost:8093
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ENABLE_SILENT_MODE=true

# AI & Speech Engine Baseline Candidate Configuration
ASR_PROVIDER=faster-whisper-turbo
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
SVI_POLICY_STATUS=PROVISIONAL_TRIAGE_POLICY
SVI_POLICY_VERSION=v2.1-provisional

# External Adapter Sandbox Switches
TELEMANAS_SANDBOX_ENABLED=true
NALSA_SANDBOX_ENABLED=true
ERSS_SANDBOX_ENABLED=true
SAMBAL_CORE_SYNC_ENABLED=false
